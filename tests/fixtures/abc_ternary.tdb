$ Synthetic ternary A-B-C database for testing binary subsystem extraction
$ (not literature data).
ELEMENT /-   ELECTRON_GAS  0.0 0.0 0.0 !
ELEMENT VA   VACUUM        0.0 0.0 0.0 !
ELEMENT A    FCC_A1        40.0 0.0 0.0 !
ELEMENT B    FCC_A1        60.0 0.0 0.0 !
ELEMENT C    FCC_A1        12.0 0.0 0.0 !
TYPE_DEFINITION % SEQ * !

FUNCTION GA 300 -5.0*T; 3000 N !
FUNCTION GB 300 -6.0*T; 3000 N !
FUNCTION GC 300 -2.0*T; 3000 N !

PHASE LIQUID % 1 1.0 !
CONSTITUENT LIQUID :A,B,C: !
PARAMETER G(LIQUID,A;0) 300 9000-8.0*T+GA; 3000 N !
PARAMETER G(LIQUID,B;0) 300 11000-8.5*T+GB; 3000 N !
PARAMETER G(LIQUID,C;0) 300 15000-7.0*T+GC; 3000 N !
PARAMETER L(LIQUID,A,B;0) 300 -4000; 3000 N !
PARAMETER L(LIQUID,A,B;1) 300 1500; 3000 N !
PARAMETER L(LIQUID,A,C;0) 300 -9000; 3000 N !
PARAMETER L(LIQUID,B,C;0) 300 2000; 3000 N !
PARAMETER L(LIQUID,A,B,C;0) 300 -12000; 3000 N !

PHASE FCC_A1 % 2 1 1 !
CONSTITUENT FCC_A1 :A,B,C:VA: !
PARAMETER G(FCC_A1,A:VA;0) 300 +GA; 3000 N !
PARAMETER G(FCC_A1,B:VA;0) 300 +GB; 3000 N !
PARAMETER G(FCC_A1,C:VA;0) 300 3000+GC; 3000 N !
PARAMETER L(FCC_A1,A,B:VA;0) 300 12000-2*T; 3000 N !
PARAMETER L(FCC_A1,A,C:VA;1) 300 -800; 3000 N !

PHASE SIGMA % 2 2 1 !
CONSTITUENT SIGMA :A,B:A,C: !
PARAMETER G(SIGMA,A:A;0) 300 5000+3*GA; 3000 N !
PARAMETER G(SIGMA,B:A;0) 300 -6000+2*GB+GA; 3000 N !
PARAMETER G(SIGMA,A:C;0) 300 -3000+2*GA+GC; 3000 N !
PARAMETER G(SIGMA,B:C;0) 300 4000+2*GB+GC; 3000 N !
PARAMETER L(SIGMA,A,B:*;0) 300 7000; 3000 N !

PHASE BC2 % 2 1 2 !
CONSTITUENT BC2 :B:C: !
PARAMETER G(BC2,B:C;0) 300 -30000+GB+2*GC; 3000 N !
