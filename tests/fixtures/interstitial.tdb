$ Synthetic interstitial test system A-C (not literature data).
$ FCC_A1 (A)1(C,VA)1 and BCC_A2 (A)1(C,VA)3 dissolve C interstitially;
$ GRAPHITE is pure C; LIQUID is a substitutional solution. Pure A is BCC
$ below 1000 K and FCC above. Energies in J per mole of formula units.
DATABASE_INFO 'Synthetic interstitial fixture for the sublattice model.' !
ELEMENT /-   ELECTRON_GAS  0.0 0.0 0.0 !
ELEMENT VA   VACUUM        0.0 0.0 0.0 !
ELEMENT A    BCC_A2        50.0 0.0 0.0 !
ELEMENT C    GRAPHITE      12.011 0.0 0.0 !

TYPE_DEFINITION % SEQ * !
DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
DEFAULT_COMMAND DEF_SYS_ELEMENT VA /- !

PHASE LIQUID:L % 1 1.0 !
CONSTITUENT LIQUID:L :A,C: !
PARAMETER G(LIQUID,A;0) 300 15000-9.0*T; 3000 N REF1 !
PARAMETER G(LIQUID,C;0) 300 60000-15.0*T; 3000 N REF1 !
PARAMETER L(LIQUID,A,C;0) 300 -70000+5*T; 3000 N REF1 !
PARAMETER L(LIQUID,A,C;1) 300 10000; 3000 N REF1 !

PHASE FCC_A1 % 2 1 1 !
CONSTITUENT FCC_A1 :A:C,VA: !
PARAMETER G(FCC_A1,A:VA;0) 300 1000-1.0*T; 3000 N REF1 !
PARAMETER G(FCC_A1,A:C;0) 300 52000-16.0*T; 3000 N REF1 !
PARAMETER L(FCC_A1,A:C,VA;0) 300 -10000; 3000 N REF1 !

PHASE BCC_A2 % 2 1 3 !
CONSTITUENT BCC_A2 :A:C,VA: !
PARAMETER G(BCC_A2,A:VA;0) 300 0.0; 3000 N REF1 !
PARAMETER G(BCC_A2,A:C;0) 300 150000-30.0*T; 3000 N REF1 !

PHASE GRAPHITE % 1 1.0 !
CONSTITUENT GRAPHITE :C: !
PARAMETER G(GRAPHITE,C;0) 300 0.0; 3000 N REF1 !

LIST_OF_REFERENCES
 NUMBER  SOURCE
 REF1    'Synthetic parameters for testing; not an assessment.'
!
