$ Synthetic magnetic test system A-B (not literature data).
$ BCC_A2 is ferromagnetic on the A side (TC = 1000 K) and antiferromagnetic
$ on the B side (TC = -300, i.e. a Neel temperature of 300 K for BCC), with a
$ composition-dependent TC (Redlich-Kister L0 and L1 on TC) and BMAGN.
$ FCC_A1 is antiferromagnetic on the A side (TC = -600, a Neel temperature
$ of 200 K for FCC). LIQUID is non-magnetic. Energies in J per mole of
$ formula units.
DATABASE_INFO 'Synthetic magnetic fixture for the Inden-Hillert-Jarl model.' !
ELEMENT /-   ELECTRON_GAS  0.0 0.0 0.0 !
ELEMENT VA   VACUUM        0.0 0.0 0.0 !
ELEMENT A    BCC_A2        55.0 0.0 0.0 !
ELEMENT B    FCC_A1        60.0 0.0 0.0 !

TYPE_DEFINITION % SEQ * !
DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
DEFAULT_COMMAND DEF_SYS_ELEMENT VA /- !

FUNCTION GBCCA 300 -8.0*T; 3000 N !
FUNCTION GFCCB 300 -9.0*T; 3000 N !

PHASE LIQUID:L % 1 1.0 !
CONSTITUENT LIQUID:L :A,B: !
PARAMETER G(LIQUID,A;0) 300 14000-17.0*T; 3000 N REF1 !
PARAMETER G(LIQUID,B;0) 300 13000-18.0*T; 3000 N REF1 !
PARAMETER L(LIQUID,A,B;0) 300 -5000; 3000 N REF1 !

TYPE_DEFINITION & GES A_P_D BCC_A2 MAGNETIC -1.0 4.00000E-01 !
PHASE BCC_A2 %& 2 1 3 !
CONSTITUENT BCC_A2 :A,B:VA: !
PARAMETER G(BCC_A2,A:VA;0) 300 +GBCCA; 3000 N REF1 !
PARAMETER G(BCC_A2,B:VA;0) 300 3000-1.0*T+GFCCB; 3000 N REF1 !
PARAMETER L(BCC_A2,A,B:VA;0) 300 9000; 3000 N REF1 !
PARAMETER TC(BCC_A2,A:VA;0) 300 1000; 3000 N REF1 !
PARAMETER TC(BCC_A2,B:VA;0) 300 -300; 3000 N REF1 !
PARAMETER TC(BCC_A2,A,B:VA;0) 300 400; 3000 N REF1 !
PARAMETER TC(BCC_A2,A,B:VA;1) 300 -200; 3000 N REF1 !
PARAMETER BMAGN(BCC_A2,A:VA;0) 300 2.2; 3000 N REF1 !
PARAMETER BMAGN(BCC_A2,B:VA;0) 300 -0.6; 3000 N REF1 !
PARAMETER BMAGN(BCC_A2,A,B:VA;0) 300 0.5; 3000 N REF1 !

TYPE_DEFINITION ( GES A_P_D FCC_A1 MAGNETIC -3.0 2.80000E-01 !
PHASE FCC_A1 %( 2 1 1 !
CONSTITUENT FCC_A1 :A,B:VA: !
PARAMETER G(FCC_A1,A:VA;0) 300 2500-1.5*T+GBCCA; 3000 N REF1 !
PARAMETER G(FCC_A1,B:VA;0) 300 +GFCCB; 3000 N REF1 !
PARAMETER L(FCC_A1,A,B:VA;0) 300 4000; 3000 N REF1 !
PARAMETER TC(FCC_A1,A:VA;0) 300 -600; 3000 N REF1 !
PARAMETER BMAGN(FCC_A1,A:VA;0) 300 -1.8; 3000 N REF1 !

LIST_OF_REFERENCES
 NUMBER  SOURCE
 REF1    'Synthetic parameters for testing; not an assessment.'
!
